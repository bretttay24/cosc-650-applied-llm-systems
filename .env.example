# ============ LLM API KEY ============
# OpenAI API key automatically read from the OPENAI_API_KEY environment variable.
# Replace this placeholder with your own key in a local .env file. Never commit .env.
OPENAI_API_KEY=your_openai_api_key_here

# =========== Microsoft Foundry ============
FOUNDRY_PROJECT_ENDPOINT=your_foundry_project_endpoint_here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

PGVECTOR_URL=postgresql://rag:<password>@127.0.0.1:55433/rag